<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="{{ homePath }}#top" aria-label="{{ copy['nav.home'].zh }}" data-i18n-aria-label="nav.home"><span class="brand-icon">M<span>F</span></span><span>Mission <span class="brand-second">Forge</span></span></a>
    <button class="menu-toggle js-only" id="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="{{ copy['nav.menu'].zh }}" data-i18n-aria-label="nav.menu"><span></span><span></span></button>
    <nav id="main-nav" aria-label="{{ copy['nav.label'].zh }}" data-i18n-aria-label="nav.label">
      <a href="{{ homePath }}leaderboard/"{% if isLeaderboard %} aria-current="page"{% endif %}>{{ t('nav.ranking') }}</a>
      <a href="{{ homePath }}jobs/"{% if isJobs %} aria-current="page"{% endif %}>{{ t('nav.jobs') }}</a>
      <a href="{{ homePath }}events/"{% if isEvents %} aria-current="page"{% endif %}>{{ t('nav.events') }}</a>
      <a href="{{ homePath }}news/"{% if isNews %} aria-current="page"{% endif %}>{{ t('nav.news') }}</a>
      <a href="{{ homePath }}blogs/"{% if isBlogs %} aria-current="page"{% endif %}>{{ t('nav.blogs') }}</a>
      <a href="https://missionhub-oss.github.io/website/">{{ t('nav.portal') }}</a>
      <a class="nav-tasks-cta" href="{{ homePath }}tasks/"{% if isTasks %} aria-current="page"{% endif %}><span class="nav-tasks-dot" aria-hidden="true"></span><span>{{ t('nav.tasks') }}</span><span class="nav-tasks-count" aria-hidden="true">{{ program.taskCatalog.stats.available }}</span></a>
    </nav>
    <div class="header-actions">
      <button class="theme-button js-only" id="theme-toggle" type="button" aria-pressed="false" aria-label="{{ copy['a11y.themeLight'].zh }}" data-i18n-aria-label="a11y.themeLight"><svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg><svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg></button>
      <button class="language-button js-only" id="language" type="button" aria-label="{{ copy['a11y.language'].zh }}" data-i18n-aria-label="a11y.language">English</button>
      <button class="account-trigger js-only" id="account-trigger" type="button" {% if isProfile %}aria-current="page"{% endif %} aria-label="{{ copy['account.signInAria'].zh }}" data-i18n-aria-label="account.signInAria"><svg class="account-user-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/></svg><span class="account-trigger-label">{{ t('account.signIn') }}</span></button>
    </div>
  </div>
</header>
{% include 'account-dialog.njk' %}
