<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="{{ homePath }}#top" aria-label="{{ copy['nav.home'].zh }}" data-i18n-aria-label="nav.home"><span class="brand-icon">M<span>F</span></span><span>Mission <span class="brand-second">Forge</span></span></a>
    <button class="menu-toggle js-only" id="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="{{ copy['nav.menu'].zh }}" data-i18n-aria-label="nav.menu"><span></span><span></span></button>
    <nav id="main-nav" aria-label="{{ copy['nav.label'].zh }}" data-i18n-aria-label="nav.label">
      <a href="{{ homePath }}leaderboard/" {% if isLeaderboard %}aria-current="page"{% else %}target="_blank" rel="noopener noreferrer" aria-label="{{ copy['nav.rankingNewTab'].zh }}" data-i18n-aria-label="nav.rankingNewTab"{% endif %}>{{ t('nav.ranking') }}</a>
      <a href="{{ homePath }}events/" {% if isEvents %}aria-current="page"{% else %}target="_blank" rel="noopener noreferrer" aria-label="{{ copy['nav.eventsNewTab'].zh }}" data-i18n-aria-label="nav.eventsNewTab"{% endif %}>{{ t('nav.events') }}</a>
      <a href="{{ homePath }}news/" {% if isNews %}aria-current="page"{% else %}target="_blank" rel="noopener noreferrer" aria-label="{{ copy['nav.newsNewTab'].zh }}" data-i18n-aria-label="nav.newsNewTab"{% endif %}>{{ t('nav.news') }}</a>
      <a class="nav-tasks-cta" href="{{ homePath }}tasks/" {% if isTasks %}aria-current="page"{% else %}target="_blank" rel="noopener noreferrer" aria-label="{{ copy['nav.tasksNewTab'].zh }}" data-i18n-aria-label="nav.tasksNewTab"{% endif %}><span class="nav-tasks-dot" aria-hidden="true"></span><span>{{ t('nav.tasks') }}</span><span class="nav-tasks-count" aria-hidden="true">{{ program.taskCatalog.stats.available }}</span></a>
    </nav>
    <div class="header-actions">
      <button class="language-button js-only" id="language" type="button" aria-label="{{ copy['a11y.language'].zh }}" data-i18n-aria-label="a11y.language">English</button>
      <a class="github-link github-star-link" href="{{ repositoryUrl }}" target="_blank" rel="noopener noreferrer" aria-label="{{ copy['nav.githubStars'].zh }}" data-i18n-aria-label="nav.githubStars"><svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.5 21.63c.55.1.76-.24.76-.53v-2.07c-3.1.67-3.76-1.32-3.76-1.32-.5-1.28-1.24-1.62-1.24-1.62-1.02-.7.08-.69.08-.69 1.12.08 1.71 1.15 1.71 1.15.99 1.7 2.6 1.2 3.23.92.1-.72.39-1.2.7-1.48-2.47-.28-5.07-1.24-5.07-5.5 0-1.22.44-2.21 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.12-1.44 3.05-1.14 3.05-1.14.61 1.54.23 2.68.11 2.96.72.79 1.15 1.78 1.15 3 0 4.27-2.6 5.22-5.09 5.5.4.35.75 1.02.75 2.06V22c0 .3.2.64.77.53A11.1 11.1 0 0 0 12 .9Z"/></svg><span class="github-star-sep" aria-hidden="true"></span><svg class="github-star-icon" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2.4 2.9 5.88 6.5.94-4.7 4.58 1.11 6.47L12 17.22l-5.81 3.05 1.11-6.47-4.7-4.58 6.5-.94L12 2.4Z"/></svg><span class="github-star-count">{{ program.repository.stars }}</span></a>
    </div>
  </div>
</header>
