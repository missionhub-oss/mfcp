{% macro t(key) %}<span data-i18n="{{ key }}">{{ copy[key].zh }}</span>{% endmacro %}
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#111111">
  <meta name="mfcp-source-commit" content="{{ program.sha }}">
  <meta name="mfcp-built-at" content="{{ program.builtAt }}">
  <meta name="description" content="{{ copy['meta.description'].zh }}">
  <meta property="og:title" content="{{ copy['meta.title'].zh }}">
  <meta property="og:description" content="{{ copy['meta.description'].zh }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ siteUrl }}">
  <link rel="canonical" href="{{ siteUrl }}">
  <link rel="icon" href="./assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="./site.css?v={{ assetVersions['site.css'] }}">
  <title>{{ copy['meta.title'].zh }}</title>
</head>
<body id="top" data-page="home">
  <a class="skip-link" href="#main">{{ t('nav.skip') }}</a>
  {% include 'header.njk' %}

  <main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="red-rule"></span>{{ t('hero.eyebrow') }}</p>
        <h1 id="hero-title">{{ t('hero.title1') }} <span class="accent">{{ t('hero.title2') }}</span></h1>
        <p class="hero-description">{{ t('hero.description') }}</p>
        <div class="button-row"><a class="button primary" href="#join">{{ t('hero.start') }}<span aria-hidden="true">↗</span></a><a class="button secondary" href="tasks/" target="_blank" rel="noopener noreferrer">{{ t('hero.tasks') }}<span aria-hidden="true">↗</span></a></div>
        <a class="text-link hero-community-link" href="{{ communityUrl }}" target="_blank" rel="noopener noreferrer"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 4H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h3v3l4-3h9a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1Z"/><path d="M7 9h10M7 13h7"/></svg>{{ t('hero.community') }}<span aria-hidden="true">↗</span></a>
      </div>
      <div class="forge-art" aria-hidden="true">
        <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="art-axis axis-x"></div><div class="art-axis axis-y"></div>
        <div class="forge-type"><span>M</span><span>F<span class="forge-dot"></span></span></div>
        <span class="art-bottom-line"></span>
      </div>
    </section>

    <div class="stats-strip">
      <div class="container stats-grid">
        <a class="stat" href="#join"><strong>{{ community.members }}</strong><span>{{ t('stats.community') }}</span></a>
        <a class="stat" href="leaderboard/" target="_blank" rel="noopener noreferrer"><strong>{{ program.stats.participants }}</strong><span>{{ t('stats.people') }}</span></a>
        <a class="stat" href="tasks/" target="_blank" rel="noopener noreferrer"><strong>{{ program.stats.tasks }}</strong><span>{{ t('stats.tasks') }}</span></a>
        <a class="stat" href="tasks/?status=claimed" target="_blank" rel="noopener noreferrer"><strong>{{ program.stats.inProgressTasks }}</strong><span>{{ t('stats.inProgress') }}</span></a>
      </div>
    </div>

    <section class="section container" id="program" aria-labelledby="program-title">
      <div class="section-intro"><h2 class="highlight-title" id="program-title">{{ t('program.title') }}</h2><div><p class="section-description">{{ t('program.description') }}</p><div class="guide-links"><a class="text-link" href="{{ repositoryUrl }}/blob/main/docs/program.md" target="_blank" rel="noopener noreferrer">{{ t('program.guide') }} <span aria-hidden="true">↗</span></a><a class="text-link" href="{{ program.rulesUrl }}" target="_blank" rel="noopener noreferrer">{{ t('levels.rules') }} <span aria-hidden="true">↗</span></a></div></div></div>
      <div class="project-grid">{% for project in projects %}<a class="project-card project-{{ project.id }}" href="{{ project.url or (repositoryUrl ~ '/blob/main/projects/' ~ project.id ~ '/README.md') }}" target="_blank" rel="noopener noreferrer"><h3 class="project-wordmark">{{ project.name }}<span aria-hidden="true">↗</span></h3><p>{{ t('tracks.' ~ project.id) }}</p></a>{% endfor %}</div>
    </section>

    <section class="section container partners-section" id="partners" aria-labelledby="partners-title">
      <h2 class="highlight-title" id="partners-title">{{ t('partners.title') }}</h2>
      <div class="partner-grid">
        <a class="partner-link partner-gevico" href="https://github.com/gevico" target="_blank" rel="noopener noreferrer">
          <span class="partner-logo"><img src="./assets/partners/gevico.png" alt="" width="1830" height="600" loading="lazy"></span>
          <span class="partner-name">{{ t('partners.gevico') }}</span>
        </a>
        <a class="partner-link partner-hust" href="https://hust.openatom.club/" target="_blank" rel="noopener noreferrer">
          <span class="partner-logo"><img src="./assets/partners/hust-openatom.png" alt="" width="753" height="323" loading="lazy"></span>
          <span class="partner-name">{{ t('partners.hust') }}</span>
        </a>
        <a class="partner-link partner-qemu-camp" href="https://qemu.gevico.online/" target="_blank" rel="noopener noreferrer">
          <span class="partner-logo"><img src="./assets/partners/qemu-camp.png" alt="" width="512" height="512" loading="lazy" decoding="async"></span>
          <span class="partner-name">{{ t('partners.qemucamp') }}</span>
        </a>
        <a class="partner-link partner-ghfind" href="https://ghfind.com/" target="_blank" rel="noopener noreferrer">
          <span class="partner-logo"><img src="./assets/partners/ghfind-mark.svg" alt="" width="64" height="64" loading="lazy"></span>
          <span class="partner-name">{{ t('partners.ghfind') }}</span>
        </a>
        <a class="partner-link partner-rustsbi" href="https://rustsbi.com/#/main" target="_blank" rel="noopener noreferrer">
          <span class="partner-logo"><img src="./assets/partners/rustsbi.png" alt="" width="200" height="200" loading="lazy"></span>
          <span class="partner-name">{{ t('partners.rustsbi') }}</span>
        </a>
        <a class="partner-link partner-cnb" href="https://cnb.cool/" target="_blank" rel="noopener noreferrer">
          <span class="partner-logo"><img src="./assets/partners/cnb.png" alt="" width="128" height="128" loading="lazy"></span>
          <span class="partner-name">{{ t('partners.cnb') }}</span>
        </a>
        <a class="partner-link partner-humanfia" href="https://humanfia.ai/" target="_blank" rel="noopener noreferrer">
          <span class="partner-logo"><img src="./assets/partners/humanfia.svg" alt="" width="96" height="108" loading="lazy"></span>
          <span class="partner-name">{{ t('partners.humanfia') }}</span>
        </a>
        <a class="partner-link partner-openruyi" href="https://www.openruyi.cn/" target="_blank" rel="noopener noreferrer">
          <span class="partner-logo"><img src="./assets/partners/openruyi.svg" alt="" width="261" height="192" loading="lazy"></span>
          <span class="partner-name">{{ t('partners.openruyi') }}</span>
        </a>
        <a class="partner-link partner-radxa" href="https://radxa.com/community/" target="_blank" rel="noopener noreferrer">
          <span class="partner-logo"><img src="./assets/partners/radxa.svg" alt="" width="64" height="20" loading="lazy"></span>
          <span class="partner-name">{{ t('partners.radxa') }}</span>
        </a>
        <a class="partner-link partner-renesas" href="https://www.renesas.com/" target="_blank" rel="noopener noreferrer">
          <span class="partner-logo"><img src="./assets/partners/renesas.png" alt="" width="1189" height="189" loading="lazy"></span>
          <span class="partner-name">{{ t('partners.renesas') }}</span>
        </a>
        <a class="partner-link partner-sifli" href="https://www.sifli.com/zh-hans" target="_blank" rel="noopener noreferrer">
          <span class="partner-logo"><img src="./assets/partners/sifli.png" alt="" width="1134" height="1134" loading="lazy"></span>
          <span class="partner-name">{{ t('partners.sifli') }}</span>
        </a>
        <a class="partner-link partner-reedpilot" href="https://www.reedpilot.com/" target="_blank" rel="noopener noreferrer">
          <span class="partner-logo"><img src="./assets/partners/reedpilot.png" alt="" width="3544" height="3544" loading="lazy" decoding="async"></span>
          <span class="partner-name">{{ t('partners.reedpilot') }}</span>
        </a>
        <a class="partner-link partner-kubuds" href="https://kubuds.io/" target="_blank" rel="noopener noreferrer">
          <span class="partner-logo"><img src="./assets/partners/kubuds.svg" alt="" width="176" height="100" loading="lazy" decoding="async"></span>
          <span class="partner-name">{{ t('partners.kubuds') }}</span>
        </a>
        <a class="partner-link partner-jiachen" href="https://rv2036.org/" target="_blank" rel="noopener noreferrer">
          <span class="partner-logo"><img src="./assets/partners/jiachen.svg" alt="" width="1191" height="1191" loading="lazy" decoding="async"></span>
          <span class="partner-name">{{ t('partners.jiachen') }}</span>
        </a>
        <a class="partner-link partner-canaan" href="https://www.kendryte.com/" target="_blank" rel="noopener noreferrer">
          <span class="partner-logo"><img src="./assets/partners/canaan.png" alt="" width="1239" height="540" loading="lazy" decoding="async"></span>
          <span class="partner-name">{{ t('partners.canaan') }}</span>
        </a>
        <a class="partner-link partner-dsh-tui" href="https://dshtui.com/" target="_blank" rel="noopener noreferrer">
          <span class="partner-logo"><img src="./assets/partners/dsh-tui.svg" alt="" width="204" height="138" loading="lazy" decoding="async"></span>
          <span class="partner-name">{{ t('partners.dshtui') }}</span>
        </a>
        <a class="partner-link partner-dsh-go" href="https://go.dshtui.com/" target="_blank" rel="noopener noreferrer">
          <span class="partner-logo"><img src="./assets/partners/dsh-go.png" alt="" width="1254" height="1254" loading="lazy" decoding="async"></span>
          <span class="partner-name">{{ t('partners.dshgo') }}</span>
        </a>
        <a class="partner-link partner-spacemit" href="https://www.spacemit.com/" target="_blank" rel="noopener noreferrer">
          <span class="partner-logo"><img src="./assets/partners/spacemit.svg" alt="" width="1920" height="523" loading="lazy" decoding="async"></span>
          <span class="partner-name">{{ t('partners.spacemit') }}</span>
        </a>
      </div>
    </section>

    <section class="join-section" id="join" aria-labelledby="join-title"><div class="container join-grid"><div><h2 id="join-title">{{ t('join.title') }}</h2><p>{{ t('join.body') }}</p><div class="button-row"><a class="button primary" href="{{ repositoryUrl }}/blob/main/participants/README.md" target="_blank" rel="noopener noreferrer">{{ t('join.register') }} <span aria-hidden="true">↗</span></a><a class="text-link" href="{{ repositoryUrl }}" target="_blank" rel="noopener noreferrer">{{ t('join.github') }} <span aria-hidden="true">↗</span></a></div><div class="initiator"><img src="./assets/process-mission.png" alt="Process Mission / 进程使命" width="310" height="100" loading="lazy"></div></div><aside class="community-card"><img src="./assets/mfcp-feishu-group.png" alt="{{ copy['join.qrAlt'].zh }}" data-i18n-alt="join.qrAlt" width="180" height="180" loading="lazy"><div><h3><a class="community-link" href="{{ communityUrl }}" target="_blank" rel="noopener noreferrer">{{ t('join.community') }} <span aria-hidden="true">↗</span></a></h3><p>{{ t('join.communityBody') }}</p></div></aside></div></section>
  </main>

  <footer class="site-footer container"><span>© {{ program.rules.year }} Process Mission</span><a href="{{ repositoryUrl }}" target="_blank" rel="noopener noreferrer">GitHub ↗</a></footer>
  <script type="application/json" id="page-data">{{ payload | jsonScript }}</script>
  <script type="module" src="./app.mjs?v={{ assetVersions['app.mjs'] }}"></script>
  <script type="module" src="./account.mjs?v={{ assetVersions['account.mjs'] }}"></script>
</body>
</html>
