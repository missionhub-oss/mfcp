{% macro t(key) %}<span data-i18n="{{ key }}">{{ copy[key].zh }}</span>{% endmacro %}
{% macro localized(value) %}<span data-en="{{ value.en }}" data-zh="{{ value.zh }}">{{ value.zh }}</span>{% endmacro %}
{% macro avatar(person, size=48) %}<span class="avatar" aria-hidden="true"><span>{{ person.initials }}</span><img src="{{ person.avatarUrl }}" alt="" width="{{ size }}" height="{{ size }}" loading="lazy"></span>{% endmacro %}
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#111111">
  <meta name="mfcp-source-commit" content="{{ program.sha }}">
  <meta name="mfcp-built-at" content="{{ program.builtAt }}">
  <meta name="description" content="{{ copy['meta.description'].zh }}">
  <meta property="og:title" content="{{ copy['meta.title'].zh }}">
  <meta property="og:description" content="{{ copy['meta.description'].zh }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ pageUrl }}">
  <link rel="canonical" href="{{ pageUrl }}">
  <link rel="icon" href="{{ homePath }}assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="{{ homePath }}site.css?v={{ assetVersions['site.css'] }}">
  <title>{{ copy['meta.title'].zh }}</title>
</head>
<body id="top" class="leaderboard-page" data-page="leaderboard">
  <a class="skip-link" href="#main">{{ t('nav.skip') }}</a>
  {% include 'header.njk' %}

  <main id="main" class="container leaderboard-main">
    <header class="hall-heading">
      <p class="eyebrow"><span class="red-rule"></span>MissionHub · MFCP</p>
      <h1 id="hall-title">{{ t('hall.title') }}</h1>
      <p class="section-description">{{ t('hall.description') }}</p>
    </header>
    <div class="hall-tabs js-only" role="tablist" aria-label="{{ copy['hall.tabsLabel'].zh }}" data-i18n-aria-label="hall.tabsLabel">
      <button class="hall-tab is-active" id="hall-tab-hall" type="button" role="tab" aria-selected="true" aria-controls="hall-of-fame" data-leaderboard-tab="hall">{{ t('hall.tab.hall') }}</button>
      <button class="hall-tab" id="hall-tab-ranking" type="button" role="tab" aria-selected="false" aria-controls="leaderboard" data-leaderboard-tab="ranking" tabindex="-1">{{ t('hall.tab.ranking') }}</button>
    </div>
    <section class="hall-panel is-active" id="hall-of-fame" role="tabpanel" aria-labelledby="hall-title" data-leaderboard-panel="hall">
      <div class="hall-toolbar">
        <a class="text-link" href="{{ communityUrl }}" target="_blank" rel="noopener noreferrer">{{ t('hall.apply') }} <span aria-hidden="true">↗</span></a>
      </div>
      {% if hallOfFame.entries.length %}
      <div class="ambassador-grid">
        {% for person in hallOfFame.entries %}
        <article class="ambassador-card">
          <div class="ambassador-portrait">
            {% if person.avatar %}<img class="ambassador-photo" src="{{ homePath }}{{ person.avatar }}" alt="" loading="lazy">{% else %}<img class="ambassador-photo" src="https://github.com/{{ person.github }}.png?size=320" alt="" loading="lazy">{% endif %}
          </div>
          <div class="ambassador-body">
            <h2><a href="https://github.com/{{ person.github }}" target="_blank" rel="noopener noreferrer">{{ localized(person.name) }}</a></h2>
            <p class="ambassador-handle">@{{ person.github }}</p>
            <div class="ambassador-tags">
              {% for tag in person.tags %}<span class="ambassador-tag is-{{ tag }}">{{ t('hall.tag.' ~ tag) }}</span>{% endfor %}
            </div>
            <p class="ambassador-bio">{{ localized(person.bio) }}</p>
            <div class="ambassador-foot">
              <span class="ambassador-since"><span>{{ t('hall.since') }}</span> {{ person.since }}</span>
              <div class="ambassador-links">
                <a class="ambassador-media" href="https://github.com/{{ person.github }}" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg></a>
                {% if person.zhihu %}<a class="ambassador-media" href="{{ person.zhihu }}" target="_blank" rel="noopener noreferrer" aria-label="{{ copy['hall.zhihu'].zh }}" data-i18n-aria-label="hall.zhihu"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M5.721 0C2.251 0 0 2.25 0 5.719V18.28C0 21.751 2.252 24 5.721 24h12.56C21.751 24 24 21.75 24 18.281V5.72C24 2.249 21.75 0 18.281 0zm1.964 4.078c-.271.73-.5 1.434-.68 2.11h4.587c.545-.006.445 1.168.445 1.171H9.384a58.104 58.104 0 01-.112 3.797h2.712c.388.023.393 1.251.393 1.266H9.183a9.223 9.223 0 01-.408 2.102l.757-.604c.452.456 1.512 1.712 1.906 2.177.473.681.063 2.081.063 2.081l-2.794-3.382c-.653 2.518-1.845 3.607-1.845 3.607-.523.468-1.58.82-2.64.516 2.218-1.73 3.44-3.917 3.667-6.497H4.491c0-.015.197-1.243.806-1.266h2.71c.024-.32.086-3.254.086-3.797H6.598c-.136.406-.158.447-.268.753-.594 1.095-1.603 1.122-1.907 1.155.906-1.821 1.416-3.6 1.591-4.064.425-1.124 1.671-1.125 1.671-1.125zM13.078 6h6.377v11.33h-2.573l-2.184 1.373-.401-1.373h-1.219zm1.313 1.219v8.86h.623l.263.937 1.455-.938h1.456v-8.86z"/></svg></a>{% endif %}
              </div>
            </div>
          </div>
        </article>
        {% endfor %}
      </div>
      {% else %}
      <div class="hall-empty">
        <p>{{ t('hall.empty') }}</p>
        <a class="button secondary" href="{{ communityUrl }}" target="_blank" rel="noopener noreferrer">{{ t('hall.apply') }}<span aria-hidden="true">↗</span></a>
      </div>
      {% endif %}
    </section>
    <section class="leaderboard-section" id="leaderboard" role="tabpanel" aria-labelledby="ranking-title" data-leaderboard-panel="ranking">
      <div class="ranking-heading">
        <div>
          <h2 id="ranking-title" tabindex="-1">{{ t('ranking.title') }}</h2>
          <p class="section-description">{{ t('ranking.description') }}</p>
        </div>
        <label class="search-field js-only"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span class="sr-only">{{ t('people.search') }}</span><input id="search" type="search" autocomplete="off" placeholder="{{ copy['people.search'].zh }}" data-i18n-placeholder="people.search"></label>
      </div>
      <p class="sr-only" role="status" aria-live="polite"><span id="visible-count">{{ program.leaderboard.length }}</span> {{ t('people.count') }}</p>
      <ol class="ranking-list" id="contributor-grid">{% for person in program.leaderboard %}
        <li class="contributor-card" id="contributor-{{ person.login | lower }}" data-login="{{ person.login | lower }}" data-level="{{ person.level }}" data-xp="{{ person.stats.experience }}" value="{{ person.rank }}">
          <details class="person-details"><summary>
            <span class="rank-position"><span class="sr-only">{{ t('ranking.rank') }} </span><span class="rank-number">{{ person.rank }}</span></span>
            {{ avatar(person) }}
            <span class="person-identity"><strong>{{ person.login }}</strong><span>L{{ person.level }} · {{ t('level.' ~ person.level) }}</span></span>
            <span class="ghfind-summary">
              <span class="ghfind-wordmark">ghfind</span>
              <span class="ghfind-badge-media"><img src="https://ghfind.com/api/badge/{{ person.login }}?lang=zh" data-ghfind-image="badge" alt="{{ copy['ghfind.badgeAlt'].zh }}" data-i18n-alt="ghfind.badgeAlt" height="20" loading="lazy" decoding="async"><span class="ghfind-image-fallback" hidden>{{ t('ghfind.unavailable') }}</span></span>
            </span>
            <span class="rank-xp"><strong>{{ person.stats.experience }}</strong> XP<span class="rank-tasks"><strong>{{ person.stats.tasks }}</strong> {{ t('profile.tasks') }}</span></span>
            <span class="expand-mark" aria-hidden="true">+</span><span class="sr-only">{{ t('profile.history') }}</span>
          </summary>
            <div class="person-detail-body">
              <section class="ghfind-panel" aria-labelledby="ghfind-{{ person.id }}">
                <div class="ghfind-panel-heading"><span class="ghfind-wordmark">ghfind <span aria-hidden="true">↗</span></span><h3 id="ghfind-{{ person.id }}">{{ t('ghfind.title') }}</h3></div>
                <a class="ghfind-card-link" href="https://ghfind.com/u/{{ person.login }}" target="_blank" rel="noopener noreferrer">
                  <img src="https://ghfind.com/api/card/mini/{{ person.login }}?variant=bars&amp;theme=dark&amp;lang=zh" data-ghfind-image="card" alt="{{ copy['ghfind.cardAlt'].zh }}" data-i18n-alt="ghfind.cardAlt" width="440" height="200" loading="lazy" decoding="async">
                  <span class="ghfind-image-fallback" hidden><span class="ghfind-wordmark">ghfind</span>{{ t('ghfind.cardUnavailable') }}</span>
                </a>
                <div class="guide-links profile-links">
                  <a class="text-link" href="https://ghfind.com/u/{{ person.login }}" target="_blank" rel="noopener noreferrer">{{ t('ghfind.visit') }} <span aria-hidden="true">↗</span></a>
                  <a class="text-link" href="{{ person.githubUrl }}" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
                  <a class="text-link" href="{{ person.recordUrl }}" target="_blank" rel="noopener noreferrer">{{ t('profile.record') }} <span aria-hidden="true">↗</span></a>
                </div>
                <p class="ghfind-invitation">{{ t('ghfind.invitation') }}</p>
                {% if person.history.length %}<ul class="history-list" aria-label="{{ copy['profile.history'].zh }}" data-i18n-aria-label="profile.history">{% for event in person.history %}<li><a href="{{ event.href }}" target="_blank" rel="noopener noreferrer">{{ localized(event.title) }} <span aria-hidden="true">↗</span></a><time datetime="{{ event.at }}" data-date="{{ event.at }}">{{ event.at | date }}</time></li>{% endfor %}</ul>{% else %}<p class="small muted profile-empty-history">{{ t('profile.noHistory') }}</p>{% endif %}
              </section>
              <div class="person-progress">
              <dl class="person-stats"><div><dt>XP</dt><dd>{{ person.stats.experience }}</dd></div><div><dt>{{ t('profile.tasks') }}</dt><dd>{{ person.stats.tasks }}</dd></div><div><dt>{{ t('profile.prs') }}</dt><dd>{{ person.stats.pull_requests }}</dd></div></dl>
              {% if person.criteria.length %}<div class="criteria"><p class="criteria-title">{{ t('profile.next') }} <strong>L{{ person.nextLevel }}</strong></p>{% for criterion in person.criteria %}<label><span>{{ t('criterion.' ~ criterion.key) }}<strong>{{ criterion.current }} / {{ criterion.required }}</strong></span><progress max="{{ criterion.required }}" value="{{ criterion.value }}">{{ criterion.current }} / {{ criterion.required }}</progress></label>{% endfor %}<p class="small muted">{{ t('profile.progressNote') }}{% if person.level == 2 %} {{ t('profile.review') }}{% endif %}</p></div>{% else %}<p class="small muted">{{ t('profile.l' ~ person.level) }}</p>{% endif %}
              </div>
            </div>
          </details>
        </li>
      {% endfor %}</ol>
      <nav class="pagination js-only" id="pagination" aria-label="{{ copy['pagination.label'].zh }}" data-i18n-aria-label="pagination.label">
        <button type="button" id="previous-page" aria-controls="contributor-grid" disabled>{{ t('pagination.previous') }}</button>
        <span id="pagination-status" role="status" aria-live="polite"></span>
        <button type="button" id="next-page" aria-controls="contributor-grid">{{ t('pagination.next') }}</button>
      </nav>
      <div class="empty-state" id="people-empty" hidden><p>{{ t('people.empty') }}</p><button type="button" class="button secondary" id="clear-filters">{{ t('people.clear') }}</button></div>
      <p class="small muted ranking-note">{{ t('ranking.note') }} {{ t('ghfind.note') }}</p>
    </section>
  </main>

  <footer class="site-footer container"><span>© {{ program.rules.year }} Process Mission</span><a href="{{ repositoryUrl }}" target="_blank" rel="noopener noreferrer">GitHub ↗</a></footer>
  <script type="application/json" id="page-data">{{ payload | jsonScript }}</script>
  <script type="module" src="{{ homePath }}app.mjs?v={{ assetVersions['app.mjs'] }}"></script>
  <script type="module" src="{{ homePath }}account.mjs?v={{ assetVersions['account.mjs'] }}"></script>
</body>
</html>
