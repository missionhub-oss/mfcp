{% macro t(key) %}<span data-i18n="{{ key }}">{{ copy[key].zh }}</span>{% endmacro %}
{% macro localized(value) %}<span data-en="{{ value.en }}" data-zh="{{ value.zh }}">{{ value.zh }}</span>{% endmacro %}
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#111111">
  <meta name="mfcp-source-commit" content="{{ program.sha }}">
  <meta name="mfcp-built-at" content="{{ program.builtAt }}">
  <meta name="description" content="{{ copy['meta.description'].zh }}">
  <meta property="og:title" content="{{ copy['meta.title'].zh }}">
  <meta property="og:description" content="{{ copy['meta.description'].zh }}">
  <meta property="og:type" content="{{ 'article' if post else 'website' }}">
  <meta property="og:url" content="{{ pageUrl }}">
  {% if post %}<meta property="og:image" content="{{ siteUrl }}blogs/{{ post.cover.src }}"><meta property="article:published_time" content="{{ post.published_at }}T00:00:00+08:00">{% endif %}
  <link rel="canonical" href="{{ pageUrl }}">
  <link rel="icon" href="{{ homePath }}assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="{{ homePath }}site.css?v={{ assetVersions['site.css'] }}">
  <link rel="stylesheet" href="{{ homePath }}blogs.css?v={{ assetVersions['blogs.css'] }}">
  <title>{{ copy['meta.title'].zh }}</title>
</head>
<body id="top" class="blogs-page">
  <a class="skip-link" href="#main">{{ t('nav.skip') }}</a>
  {% include 'header.njk' %}
  <main id="main" class="container blogs-main">
    {% if post %}
    <header class="blog-post-header">
      <nav class="blog-breadcrumb" aria-label="{{ copy['blogs.breadcrumb'].zh }}" data-i18n-aria-label="blogs.breadcrumb"><a href="{{ homePath }}">{{ t('blogs.home') }}</a><span aria-hidden="true">/</span><a href="{{ homePath }}blogs/">{{ t('nav.blogs') }}</a></nav>
      <h1>{{ localized(post.localizedTitle) }}</h1>
      <div class="blog-post-meta-bar">
        <p class="blog-post-meta"><span>{{ t('blogs.author') }} <strong>{{ localized(post.localizedAuthor) }}</strong></span><span aria-hidden="true">·</span><time datetime="{{ post.published_at }}" data-date="{{ post.published_at }}">{{ post.published_at | date }}</time><span aria-hidden="true">·</span><span>{{ localized(post.readingTime) }}</span></p>
        {% if post.video_url or post.slides_path %}
        <div class="blog-resources">
          {% if post.video_url %}<a href="{{ post.video_url }}" target="_blank" rel="noopener noreferrer">{{ t('blogs.watchReplay') }}<span aria-hidden="true"> ↗</span></a>{% endif %}
          {% if post.slides_path %}<a href="{{ homePath }}{{ post.slides_path }}" target="_blank" rel="noopener noreferrer">{{ t('blogs.downloadSlides') }}<span aria-hidden="true"> ↗</span></a>{% endif %}
        </div>
        {% endif %}
      </div>
    </header>
    <div class="blog-layout{% if post.toc.length %} has-toc{% endif %}">
      {% if post.toc.length %}
      <aside class="blog-toc-sidebar" aria-label="{{ copy['blogs.toc'].zh }}" data-i18n-aria-label="blogs.toc">
        <p class="blog-toc-title">{{ t('blogs.toc') }}</p>
        <ul{% if post.en %} data-lang-block="zh"{% endif %}>{% for item in post.toc %}<li><a href="#{{ item.id }}">{{ item.text }}</a></li>{% endfor %}</ul>
        {% if post.en %}<ul data-lang-block="en">{% for item in post.en.toc %}<li><a href="#{{ item.id }}">{{ item.text }}</a></li>{% endfor %}</ul>{% endif %}
      </aside>
      {% endif %}
      <article class="blog-post">
        {% if post.toc.length %}
        <details class="blog-toc-mobile">
          <summary>{{ t('blogs.toc') }}</summary>
          <ul{% if post.en %} data-lang-block="zh"{% endif %}>{% for item in post.toc %}<li><a href="#{{ item.id }}">{{ item.text }}</a></li>{% endfor %}</ul>
          {% if post.en %}<ul data-lang-block="en">{% for item in post.en.toc %}<li><a href="#{{ item.id }}">{{ item.text }}</a></li>{% endfor %}</ul>{% endif %}
        </details>
        {% endif %}
        <div class="blog-body"{% if post.en %} data-lang-block="zh"{% endif %} lang="zh-CN">{{ post.html | safe }}</div>
        {% if post.en %}
        <div class="blog-body" data-lang-block="en" lang="en">{{ post.en.html | safe }}</div>
        {% endif %}
        <footer class="blog-post-footer">
          <a class="text-link" href="{{ homePath }}blogs/">← {{ t('blogs.back') }}</a>
          <a class="text-link" href="#top">{{ t('blogs.top') }} ↑</a>
        </footer>
      </article>
    </div>
    <dialog class="blog-lightbox" id="blog-lightbox" aria-label="{{ copy['blogs.lightbox'].zh }}" data-i18n-aria-label="blogs.lightbox">
      <div class="blog-lightbox-bar">
        <span class="blog-lightbox-caption" id="blog-lightbox-caption"></span>
        <button class="blog-lightbox-close" id="blog-lightbox-close" type="button" aria-label="{{ copy['blogs.closeLightbox'].zh }}" data-i18n-aria-label="blogs.closeLightbox">×</button>
      </div>
      <img id="blog-lightbox-image" alt="">
    </dialog>
    {% else %}
    <header class="blogs-heading"><p class="eyebrow"><span class="red-rule"></span>MissionHub · MFCP</p><h1>{{ t('blogs.title') }}</h1><p class="section-description">{{ t('blogs.description') }}</p></header>
    {% if featured %}
    <article class="blog-feature">
      <a class="blog-feature-image" href="{{ featured.slug }}/" tabindex="-1" aria-hidden="true"><img src="{{ featured.cover.src }}" alt="" width="{{ featured.cover.width }}" height="{{ featured.cover.height }}" decoding="async"></a>
      <div class="blog-feature-copy">
        <p class="blog-kicker">{{ localized(featured.localizedAuthor) }}<span aria-hidden="true">·</span><time datetime="{{ featured.published_at }}" data-date="{{ featured.published_at }}">{{ featured.published_at | date }}</time><span aria-hidden="true">·</span>{{ localized(featured.readingTime) }}</p>
        {% if featured.tags.length %}<ul class="blog-tags">{% for tag in featured.tags %}<li>{{ tag }}</li>{% endfor %}</ul>{% endif %}
        <h2><a href="{{ featured.slug }}/">{{ localized(featured.localizedTitle) }}</a></h2>
        <p>{{ localized(featured.localizedSummary) }}</p>
        <a class="text-link" href="{{ featured.slug }}/">{{ t('blogs.read') }} <span aria-hidden="true">↗</span></a>
      </div>
    </article>
    {% endif %}
    {% if otherBlogs.length %}
    <section class="blogs-list" aria-labelledby="blogs-list-title"><h2 id="blogs-list-title">{{ t('blogs.more') }}</h2><div class="blogs-grid">
      {% for item in otherBlogs %}
      <article class="blog-card">
        <a class="blog-card-cover" href="{{ item.slug }}/" tabindex="-1" aria-hidden="true"><img src="{{ item.cover.src }}" alt="" width="{{ item.cover.width }}" height="{{ item.cover.height }}" loading="lazy" decoding="async"></a>
        <div class="blog-card-copy">
          <p class="blog-kicker">{{ localized(item.localizedAuthor) }}<span aria-hidden="true">·</span><time datetime="{{ item.published_at }}" data-date="{{ item.published_at }}">{{ item.published_at | date }}</time><span aria-hidden="true">·</span>{{ localized(item.readingTime) }}</p>
          <h3><a href="{{ item.slug }}/">{{ localized(item.localizedTitle) }}</a></h3>
          <p>{{ localized(item.localizedSummary) }}</p>
          <a class="blog-card-action" href="{{ item.slug }}/">{{ t('blogs.read') }} <span aria-hidden="true">↗</span></a>
        </div>
      </article>
      {% endfor %}
    </div></section>
    {% endif %}
    {% endif %}
  </main>
  <footer class="site-footer container"><span>© {{ program.rules.year }} Process Mission</span><a href="{{ repositoryUrl }}" target="_blank" rel="noopener noreferrer">GitHub ↗</a></footer>
  <script type="application/json" id="page-data">{{ payload | jsonScript }}</script>
  <script type="module" src="{{ homePath }}app.mjs?v={{ assetVersions['app.mjs'] }}"></script>
  <script type="module" src="{{ homePath }}account.mjs?v={{ assetVersions['account.mjs'] }}"></script>
</body>
</html>
