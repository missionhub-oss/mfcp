{% macro t(key) %}<span data-i18n="{{ key }}">{{ copy[key].zh }}</span>{% endmacro %}
{% macro localized(value) %}<span data-en="{{ value.en }}" data-zh="{{ value.zh }}">{{ value.zh }}</span>{% endmacro %}
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#111111">
  <meta name="mfcp-source-commit" content="{{ program.sha }}">
  <meta name="mfcp-built-at" content="{{ program.builtAt }}">
  <meta name="description" content="{{ copy['meta.description'].zh }}">
  <meta property="og:title" content="{{ copy['meta.title'].zh }}">
  <meta property="og:description" content="{{ copy['meta.description'].zh }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ siteUrl }}events/">
  <link rel="canonical" href="{{ siteUrl }}events/">
  <link rel="icon" href="{{ homePath }}assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="{{ homePath }}site.css?v={{ assetVersions['site.css'] }}">
  <title>{{ copy['meta.title'].zh }}</title>
</head>
<body id="top" class="events-page">
  <a class="skip-link" href="#main">{{ t('nav.skip') }}</a>
  {% include 'header.njk' %}
  <main id="main" class="container events-main">
    <header class="events-heading"><p class="eyebrow"><span class="red-rule"></span>MissionHub · MFCP</p><h1>{{ t('events.title') }}</h1><p class="section-description">{{ t('events.description') }}</p></header>
    <div class="event-schedule">
      <div><span class="event-kicker">{{ t('events.schedule_label') }}</span><strong>{{ t('events.schedule') }}</strong></div>
      <a class="button primary" href="{{ communityUrl }}" target="_blank" rel="noopener noreferrer">{{ t('nav.join') }}<span aria-hidden="true">↗</span></a>
    </div>
    <section aria-labelledby="event-list-title">
      <h2 class="event-list-title" id="event-list-title">{{ t('events.replays') }}</h2>
      <div class="event-grid">
        {% for replay in events.replays %}
        <article class="event-card">
          <p class="event-meta"><time datetime="{{ replay.date }}" data-date="{{ replay.date }}">{{ replay.date | date }}</time><span>{{ replay.duration }}</span></p>
          <h3><a class="event-title-link" href="{{ replay.url }}" target="_blank" rel="noopener noreferrer">{{ localized(replay.title) }}<span aria-hidden="true">↗</span></a></h3>
          <div class="event-action">
            <a href="{{ replay.url }}" target="_blank" rel="noopener noreferrer">{{ t('events.watch') }}<span aria-hidden="true">↗</span></a>
            {% if replay.slides %}<a class="event-slides" href="{{ homePath }}{{ replay.slides }}" target="_blank" rel="noopener noreferrer">{{ t('events.slides') }}<span aria-hidden="true">↗</span></a>{% endif %}
          </div>
        </article>
        {% endfor %}
      </div>
      <p class="small muted event-note"><a class="text-link" href="{{ events.collection_url }}" target="_blank" rel="noopener noreferrer">{{ t('events.collection') }} <span aria-hidden="true">↗</span></a></p>
    </section>
  </main>
  <footer class="site-footer container"><span>© {{ program.rules.year }} Process Mission</span><a href="{{ repositoryUrl }}" target="_blank" rel="noopener noreferrer">GitHub ↗</a></footer>
  <script type="application/json" id="page-data">{{ payload | jsonScript }}</script>
  <script type="module" src="{{ homePath }}app.mjs?v={{ assetVersions['app.mjs'] }}"></script>
</body>
</html>
