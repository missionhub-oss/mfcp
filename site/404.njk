<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#111111">
  <title>MFCP · 开源履历</title>
  <style>
    body{margin:0;min-height:100vh;display:grid;place-items:center;background:#111;color:#f5ede0;font:15px/1.6 system-ui,-apple-system,sans-serif;padding:24px}
    .box{max-width:460px;padding:28px;background:#181716;border:1px solid #d5a65745;border-top:2px solid #b22600;border-radius:3px}
    h1{margin:0 0 10px;font-size:22px}
    p{margin:0 0 18px;color:#b8b3a8}
    .links{display:flex;gap:12px;flex-wrap:wrap}
    a{color:#f1d396;text-decoration:none;padding:7px 13px;border:1px solid #d5a65745;border-radius:2px;font-size:13px;font-weight:600}
    a:hover{border-color:#d5a657;color:#fff}
  </style>
</head>
<body>
  <main class="box" id="not-found-box" hidden>
    <h1>页面未找到 · Page Not Found</h1>
    <p>未找到对应的 MFCP 页面或贡献者履历，请返回首页或通过 GitHub 用户名查询。</p>
    <div class="links">
      <a id="link-home" href="./">返回首页</a>
      <a id="link-profile" href="./profile/">查询开源履历</a>
    </div>
  </main>
  <script>
    (async () => {
      const reserved = new Set(['assets', 'events', 'leaderboard', 'news', 'profile', 'slides', 'tasks']);
      const base = location.pathname.startsWith('/mfcp/') ? '/mfcp/' : '/';
      const homeLink = document.getElementById('link-home');
      const profileLink = document.getElementById('link-profile');
      if (homeLink) homeLink.href = base;
      if (profileLink) profileLink.href = `${base}profile/`;
      const rel = location.pathname.slice(base.length).replace(/^\/+|\/+$/g, '');
      if (rel && !rel.includes('/') && /^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9])){0,38}$/i.test(rel)) {
        try {
          const res = await fetch(`${base}profile-index.json`, {cache: 'no-cache'});
          if (res.ok) {
            const idx = await res.json();
            const match = (idx.participants || []).find(p => p.login.toLowerCase() === rel.toLowerCase());
            if (match && !reserved.has(match.login.toLowerCase())) {
              const target = `${base}${encodeURIComponent(match.login.toLowerCase())}/`;
              if (location.pathname !== target) {
                location.replace(target);
                return;
              }
            }
          }
        } catch {}
      }
      document.getElementById('not-found-box').hidden = false;
    })();
  </script>
</body>
</html>
